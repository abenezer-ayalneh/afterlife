{
  "name": "afterlife",
  "version": "1.0.0",
  "description": "Chapter persuasiveness survey for An Afterlife for Atheists",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "check": "astro check",
    "preview": "astro preview --host 127.0.0.1",
    "types": "wrangler types --strict-vars false",
    "db:local": "wrangler d1 migrations apply DB --local",
    "test": "tsx --test tests/*.test.ts",
    "build:staging": "CLOUDFLARE_ENV=staging astro build",
    "build:production": "CLOUDFLARE_ENV=production astro build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/wittgenstein": "^5.3.0",
    "astro": "^7.3.8",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.19.1",
    "miniflare": "^5.20261006.1-alpha",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.149.0"
  }
}
