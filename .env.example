# Copy to .env for Astro development only.
# Initialize the database with npm run db:local.
# Set each administrator password with APP_ENV=local node scripts/admin-account.mjs EMAIL.
# Passwords are entered privately and stored as hashes in SQLite, never in this file.
APP_ENV=local
PUBLIC_ORIGIN=http://localhost:4321
DATABASE_PATH=.data/local.sqlite
ADMIN_EMAILS=abenezer.ayalneh.42@gmail.com,boersarama@gmail.com
# Optional locally: leaving this empty uses the development-only default.
# For deployment, use deploy/staging.env.example instead.
RATE_LIMIT_SALT=
