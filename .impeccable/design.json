      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Explicit native survey action with theme-aware state feedback.",
      "html": "<button class=\"ds-button\">Submit rating</button>",
      "css": ".ds-button{font-family:var(--sans,'Source Sans 3',system-ui,sans-serif);font-size:18px;line-height:1.3;display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:9px 24px;border:1px solid transparent;border-radius:3px;background:var(--accent,#4d603f);color:var(--on-accent,#fff);cursor:pointer}.ds-button:hover{filter:brightness(.94)}.ds-button:focus-visible{outline:3px solid var(--focus,#6c7434);outline-offset:4px}.ds-button:disabled{opacity:.65;cursor:wait}"
    },
    {
