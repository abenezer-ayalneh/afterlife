      "kind": "button",
      "refersTo": "button-danger",
      "description": "Explicit native survey action with theme-aware state feedback.",
      "html": "<button class=\"ds-button ds-danger\">Delete comment</button>",
      "css": ".ds-button{font-family:var(--sans,'Source Sans 3',system-ui,sans-serif);font-size:18px;line-height:1.3;display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:9px 24px;border:1px solid transparent;border-radius:3px;background:var(--accent,#4d603f);color:var(--on-accent,#fff);cursor:pointer}.ds-button:hover{filter:brightness(.94)}.ds-button:focus-visible{outline:3px solid var(--focus,#6c7434);outline-offset:4px}.ds-button:disabled{opacity:.65;cursor:wait}.ds-danger{background:var(--danger,#923a30);color:var(--surface,#f5f2ed)}"
    },
    {
      "name": "Comment Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible label and theme-aware native text entry.",
      "html": "<label class=\"ds-label\">Comment<textarea class=\"ds-field\" rows=\"3\"></textarea></label>",
      "css": ".ds-label{display:block;font:16px/1.5 var(--sans,\"Source Sans 3\",system-ui,sans-serif);color:var(--text,#22241f)}.ds-field{display:block;width:100%;margin-top:6px;padding:10px 12px;border:1px solid var(--control-line,#7f8774);border-radius:2px;background:var(--field,#faf8f4);color:var(--text,#22241f);font:18px/1.5 var(--sans,\"Source Sans 3\",system-ui,sans-serif);resize:vertical;min-height:100px;caret-color:var(--accent,#4d603f)}.ds-field:focus-visible{outline:3px solid var(--focus,#6c7434);outline-offset:4px}"
    },
    {
      "name": "Contents Row",
      "kind": "custom",
      "refersTo": "chapter-row",
      "description": "Vertically centered number, serif title, and SVG arrow in 90px desktop and 124px mobile chapter rows. Dividers separate rows; omit the bottom border on the last row.",
      "html": "<a class=\"ds-row\" href=\"#\"><span class=\"ds-number\">01</span><span class=\"ds-title\">Chapter 1</span><svg width=\"32\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
      "css": ".ds-row{display:grid;grid-template-columns:48px 1fr 32px;align-items:center;gap:20px;padding:4px 20px;min-height:90px;border-bottom:1px solid var(--line,#cfcdc0);color:var(--text,#22241f);text-decoration:none;transition:background .16s ease}.ds-number{font:15px/1.5 var(--sans,\"Source Sans 3\",system-ui,sans-serif);font-variant-numeric:tabular-nums;color:var(--muted,#5b6253)}.ds-title{font:400 25px/1.3 var(--serif,Wittgenstein,Georgia,serif);overflow-wrap:anywhere}.ds-row svg{color:var(--accent,#4d603f)}.ds-row:hover{background:var(--hover,#eeece6)}.ds-row:focus-visible{outline:3px solid var(--focus,#6c7434);outline-offset:4px}@media(max-width:680px){.ds-row{grid-template-columns:26px 1fr 20px;gap:14px;min-height:124px;padding:12px 0}.ds-title{font-size:23px}}@media(prefers-reduced-motion:reduce){.ds-row{transition:none}}.ds-row:last-child{border-bottom:0}"
    },
    {
      "name": "Score Tile",
      "kind": "custom",
      "refersTo": "score-mobile",
      "description": "Narrow-screen radio choice with outlined, selected, and keyboard focus states.",
      "html": "<label class=\"ds-score\"><input type=\"radio\" name=\"ds-score\" value=\"5\" aria-label=\"5\"><span>5</span></label>",
      "css": ".ds-score{display:inline-flex;position:relative;align-items:center;justify-content:center;min-width:44px;min-height:48px;border:1px solid var(--control-line,#7f8774);border-radius:3px;color:var(--text,#22241f);font:18px/1.5 var(--sans,\"Source Sans 3\",system-ui,sans-serif);cursor:pointer;font-variant-numeric:tabular-nums}.ds-score input{position:absolute;opacity:0;width:100%;height:100%;inset:0;cursor:pointer}.ds-score:hover{background:var(--hover,#eeece6)}.ds-score:has(input:checked){background:var(--accent,#4d603f);color:var(--on-accent,#fff);border-color:var(--accent,#4d603f)}.ds-score:has(input:focus-visible){outline:3px solid var(--focus,#6c7434);outline-offset:4px}"
    },
    {
      "name": "Theme Navigation",
      "kind": "nav",
      "description": "Persistent Light, System, and Dark preferences using named 44px icon buttons with selected and keyboard focus states.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-name\" href=\"#\">Reader survey</a><div class=\"ds-theme\" role=\"group\" aria-label=\"Color theme\">\n    <button type=\"button\" class=\"ds-theme-option\" data-theme-choice=\"light\" aria-label=\"Light theme\" aria-pressed=\"true\" title=\"Light theme\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\" /><path d=\"M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5\" /></svg></button>\n    <button type=\"button\" class=\"ds-theme-option\" data-theme-choice=\"system\" aria-label=\"System theme\" aria-pressed=\"false\" title=\"System theme\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"13\" rx=\"2\" /><path d=\"M12 17v4m-4 0h8\" /></svg></button>\n    <button type=\"button\" class=\"ds-theme-option\" data-theme-choice=\"dark\" aria-label=\"Dark theme\" aria-pressed=\"false\" title=\"Dark theme\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20.7 13.2A9 9 0 0 1 10.8 3.3 9 9 0 1 0 20.7 13.2Z\" /></svg></button>\n  </div></nav>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:54px;border-bottom:1px solid var(--line,#cfcdc0);font:15px/1.5 var(--sans,\"Source Sans 3\",system-ui,sans-serif);color:var(--text,#22241f)}.ds-name{text-decoration:none;color:inherit}.ds-theme{display:flex;align-items:center;gap:4px;flex-shrink:0}.ds-theme-option{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:1px solid transparent;border-radius:3px;background:transparent;color:var(--muted,#5b6253);cursor:pointer}.ds-theme-option:hover{background:var(--hover,#eeece6)}.ds-theme-option[aria-pressed=true]{background:var(--hover,#eeece6);color:var(--accent,#4d603f);border-color:var(--control-line,#7f8774)}.ds-name:hover{text-decoration:underline}.ds-name:focus-visible,.ds-theme-option:focus-visible{outline:3px solid var(--focus,#6c7434);outline-offset:4px}"
    }
