---
import {env} from '../lib/runtime';
import {formToken} from '../lib/security';
interface Props{action:string}
const {action}=Astro.props;
const token=formToken(env,Astro.locals.owner,action);
---
<input type="hidden" name="formToken" value={token} />
<div class="spam-trap" aria-hidden="true"><label>Leave this field empty<input type="text" name="contact_url" value="" tabindex="-1" autocomplete="off" /></label></div>
<style>.spam-trap{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;}</style>
