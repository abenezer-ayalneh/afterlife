---
import {env} from '../../lib/runtime';
import Verification from '../../components/Verification.astro';
import Shell from '../../layouts/Shell.astro';
import {chapters,results} from '../../lib/db';
const index=await chapters(env.DB);const comparisons=await Promise.all(index.map(async item=>({...item,...await results(env.DB,item.id)})));
const cursor=Astro.url.searchParams.get('before');let boundary:{date:string;id:string}|undefined;
if(cursor){try{boundary=JSON.parse(atob(cursor));if(!boundary||typeof boundary.date!=='string'||typeof boundary.id!=='string'||cursor.length>300)boundary=undefined;}catch{boundary=undefined;}}
const query=`SELECT id,chapter_id,author,body,hidden,created_at FROM comments WHERE deleted_at IS NULL ${boundary?'AND (created_at < ? OR (created_at = ? AND id < ?))':''} ORDER BY created_at DESC,id DESC LIMIT 50`;
const statement=env.DB.prepare(query);const rows=(await (boundary?statement.bind(boundary.date,boundary.date,boundary.id):statement).all<{id:string;chapter_id:number;author:string|null;body:string;hidden:number;created_at:string}>()).results;
const reports=(await env.DB.prepare('SELECT r.id,r.comment_id,r.reason,r.created_at,c.chapter_id,c.author,c.body,c.hidden FROM reports r JOIN comments c ON c.id=r.comment_id WHERE r.resolved_at IS NULL AND c.deleted_at IS NULL ORDER BY r.created_at DESC LIMIT 100').all<{id:number;comment_id:string;reason:string;created_at:string;chapter_id:number;author:string|null;body:string;hidden:number}>()).results;
---
<Shell title="Administrator">
  <header class="admin-intro"><h1>Administrator</h1><p class="muted">Signed in as {Astro.locals.admin}</p><form method="post" action="/admin/logout"><Verification action="logout" /><button class="secondary">Sign out</button></form><nav class="admin-nav" aria-label="Administrator sections"><a href="#comparison">Chapter results</a><a href="#moderation">Comments</a><a href="#reports">Reports</a><a href="#chapters">Chapters</a></nav></header>
  {Astro.url.searchParams.has('saved') && <p class="admin-message" role="status">The change has been saved.</p>}
  <section id="comparison"><h2>Chapter results</h2><div class="admin-nav"><a href="/admin/api/export/ratings">Export ratings CSV</a><a href="/admin/api/export/comments">Export comments CSV</a></div><div class="table-wrap"><table><caption class="sr-only">Chapter rating averages, response counts, and distributions</caption><thead><tr><th>Chapter</th><th>Average / 10</th><th>Responses</th>{Array.from({length:11},(_,i)=><th scope="col">{i}</th>)}</tr></thead><tbody>{comparisons.map(item=><tr><th scope="row"><a href={`/chapters/${item.id}`}>{item.title}</a></th><td>{item.average===null?'No ratings yet':item.average.toFixed(2)}</td><td>{item.count}</td>{item.distribution.map(count=><td>{count}</td>)}</tr>)}</tbody></table></div></section>
  <section id="reports" class="admin-section"><h2>Reports</h2>{reports.length===0 && <p class="muted">No reports awaiting review.</p>}{reports.map(report=><article class="admin-comment"><h3>{index.find(row=>row.id===report.chapter_id)?.title} · {report.author||'Anonymous reader'}</h3><p>{report.body}</p><p class="admin-report">Report: {report.reason}</p><form method="post" action="/admin/api/hide"><Verification action="admin:hide" /><input type="hidden" name="comment" value={report.comment_id} /><button class="secondary">Hide comment</button></form><form method="post" action="/admin/api/resolve"><Verification action="admin:resolve" /><input type="hidden" name="report" value={report.id} /><button>Mark reviewed</button></form></article>)}</section>
  <section id="moderation" class="admin-section"><h2>Comments</h2><p class="muted">Reader-deleted comments are excluded. Hiding a comment preserves it for review.</p>{rows.length===0 && <p>No comments yet.</p>}{rows.map(item=><article class="admin-comment"><h3>{index.find(row=>row.id===item.chapter_id)?.title} · {item.author||'Anonymous reader'}</h3><p class="muted">{item.hidden?'Hidden':'Public'} · {new Date(item.created_at).toLocaleDateString('en')}</p><p>{item.body}</p><form method="post" action={`/admin/api/${item.hidden?'restore':'hide'}`}><Verification action={`admin:${item.hidden?'restore':'hide'}`} /><input type="hidden" name="comment" value={item.id} /><button class="secondary">{item.hidden?'Restore comment':'Hide comment'}</button></form></article>)}{rows.length===50 && <a href={`/admin?before=${encodeURIComponent(btoa(JSON.stringify({date:rows.at(-1)!.created_at,id:rows.at(-1)!.id})))}#moderation`}>Older comments</a>}</section>
  <section id="chapters" class="admin-section"><h2>Chapter titles</h2><p class="muted">Numbered chapter addresses stay the same when titles change.</p>{index.map(item=><div class="admin-row"><form class="reader-form" method="post" action="/admin/api/rename"><Verification action="admin:rename" /><input type="hidden" name="chapter" value={item.id} /><label>Chapter {item.id}<input name="title" value={item.title} maxlength="200" required /></label><button>Save title</button></form></div>)}<h3 style="margin-top:32px">Add a chapter</h3><form class="reader-form" method="post" action="/admin/api/add"><Verification action="admin:add" /><label>Chapter title<input name="title" maxlength="200" required /></label><input type="hidden" name="requestId" value={crypto.randomUUID()} /><button>Add chapter</button></form></section>
</Shell>
